// BildAp — data model (PostgreSQL)

generator client {
  provider      = "prisma-client-js"
  // "native" para tu máquina; "rhel-openssl-3.0.x" para las funciones de Netlify (AWS Lambda).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  color       String    @default("#f0a500")
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String    // Markdown
  coverImage  String?
  readMinutes Int       @default(5)
  featured    Boolean   @default(false)
  published   Boolean   @default(true)
  author      String    @default("Equipo BildAp")
  tags        String    @default("") // comma separated
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, featured])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String
  description String
  icon        String   @default("HardHat") // lucide icon name
  features    String   @default("")         // pipe separated
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Flexible key/value store for editable homepage / site content blocks.
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  service   String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled])
}

// Newsletter subscribers.
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("web") // where they subscribed from
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Public members (registered via Google, etc.). Separate from admin `User`.
model Member {
  id            String               @id @default(cuid())
  email         String               @unique
  name          String
  image         String?
  provider      String               @default("google")
  savedItems    SavedItem[]
  calculations  SavedCalculation[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

// Favoritos guardados por un miembro (inmuebles, profesionales, etc.).
model SavedItem {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type      String // "property" | "professional" | "material" | "article"
  refId     String // slug o clave única para deduplicar
  title     String
  subtitle  String?
  href      String?
  image     String?
  createdAt DateTime @default(now())

  @@unique([memberId, type, refId])
  @@index([memberId])
}

// Cálculos de materiales guardados (presupuestos estimados).
model SavedCalculation {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name      String // "Casa de 100m²", "Amurado del patio", etc.
  calcType  String // "h17" | "h21" | "h30" | "ladrillo" | "bloque" | etc.
  quantity  Float // cantidad base (m² o kg o m³)
  result    String // JSON: { cemento: 10, arena: 20, ... } (Cantidad total de material)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
}

// Bolsa de trabajo — profesionales asociados.
model Professional {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  profession  String // "Arquitecto/a", "Ingeniero/a Civil", "Maestro Mayor de Obra", etc.
  bio         String
  photo       String?
  location    String   @default("Córdoba")
  phone       String?
  whatsapp    String?
  email       String?
  specialties String   @default("") // pipe separated
  featured    Boolean  @default(false)
  active      Boolean  @default(true) // controlado por suscripción a futuro
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, featured])
}

// Servicio inmobiliario — inmuebles publicados por constructoras/inmobiliarias.
model Property {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  operation   String   @default("venta") // "venta" | "alquiler"
  type        String   @default("casa") // casa | departamento | lote | local | oficina
  price       Float?
  currency    String   @default("USD") // USD | ARS
  location    String
  bedrooms    Int?
  bathrooms   Int?
  area        Float? // m2 cubiertos
  coverImage  String?
  images      String   @default("") // pipe separated URLs
  description String
  agency      String // constructora / inmobiliaria
  phone       String?
  whatsapp    String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, operation, type])
}
