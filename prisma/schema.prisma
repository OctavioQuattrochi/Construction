// BildAp — data model (PostgreSQL)

generator client {
  provider      = "prisma-client-js"
  // "native" para tu máquina; "rhel-openssl-3.0.x" para las funciones de Netlify (AWS Lambda).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  color       String    @default("#f0a500")
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String    // Markdown
  coverImage  String?
  readMinutes Int       @default(5)
  featured    Boolean   @default(false)
  published   Boolean   @default(true)
  author      String    @default("Equipo BildAp")
  tags        String    @default("") // comma separated
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, featured])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String
  description String
  icon        String   @default("HardHat") // lucide icon name
  features    String   @default("")         // pipe separated
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Flexible key/value store for editable homepage / site content blocks.
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  service   String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled])
}

// Newsletter subscribers.
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("web") // where they subscribed from
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Public members (registered via Google, etc.). Separate from admin `User`.
model Member {
  id            String               @id @default(cuid())
  email         String               @unique
  name          String
  image         String?
  provider      String               @default("google")
  savedItems    SavedItem[]
  calculations  SavedCalculation[]
  obras         Obra[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

// Favoritos guardados por un miembro (inmuebles, profesionales, etc.).
model SavedItem {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type      String // "property" | "professional" | "material" | "article"
  refId     String // slug o clave única para deduplicar
  title     String
  subtitle  String?
  href      String?
  image     String?
  createdAt DateTime @default(now())

  @@unique([memberId, type, refId])
  @@index([memberId])
}

// ---------------------------------------------------------------- MI OBRA
// El proyecto de obra del usuario: presupuesto, materiales, gastos y bitácora.
model Obra {
  id           String         @id @default(cuid())
  memberId     String
  member       Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name         String
  location     String?
  startDate    DateTime?
  estimatedEnd DateTime?
  status       String         @default("planificacion") // planificacion | ejecucion | terminada | pausada
  // Línea base: el presupuesto original NO se toca. Los aumentos se registran
  // como ajustes, así siempre se ve por qué subió la obra.
  baselineTotal   Float?
  baselineAt      DateTime?
  baselineUsdRate Float? // cotización del dólar al fijar la línea base
  rubros       ObraRubro[]
  adjustments  ObraAdjustment[]
  materials    ObraMaterial[]
  expenses     ObraExpense[]
  logs         ObraLog[]
  participants ObraMember[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([memberId])
}

/**
 * Ajuste del presupuesto. La clave del modelo: nunca se edita el presupuesto
 * original, se suman ajustes con su motivo. Así el propietario ve exactamente
 * cuánto subió por inflación y cuánto por cambios que él pidió.
 */
model ObraAdjustment {
  id        String   @id @default(cuid())
  obraId    String
  obra      Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  type      String // inflacion | cambio | correccion
  amount    Float // puede ser negativo (ahorro / reducción de alcance)
  reason    String
  days      Int      @default(0) // impacto en el plazo
  approved  Boolean  @default(false) // los "cambio" los aprueba el propietario
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([obraId])
}

// Participante invitado a una obra. Se invita por email: si todavía no tiene
// cuenta, al registrarse con ese email obtiene acceso automáticamente.
model ObraMember {
  id        String   @id @default(cuid())
  obraId    String
  obra      Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  email     String // en minúsculas
  name      String? // nombre de referencia que carga quien invita
  role      String   @default("viewer") // editor (carga avance) | viewer (sólo mira)
  createdAt DateTime @default(now())

  @@unique([obraId, email])
  @@index([email])
}

// Rubro / etapa de obra con su presupuesto y avance declarado.
model ObraRubro {
  id        String        @id @default(cuid())
  obraId    String
  obra      Obra          @relation(fields: [obraId], references: [id], onDelete: Cascade)
  name      String
  budgeted  Float         @default(0)
  progress  Int           @default(0) // 0-100, declarado por el usuario
  order     Int           @default(0)
  expenses  ObraExpense[]
  createdAt DateTime      @default(now())

  @@index([obraId])
}

// Material necesario para la obra (viene de calculadoras o del comparador).
model ObraMaterial {
  id        String   @id @default(cuid())
  obraId    String
  obra      Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  label     String
  qty       Float    @default(0)
  unit      String?
  unitPrice Float? // precio de referencia al momento de agregarlo
  store     String?
  url       String?
  status    String   @default("necesario") // necesario | comprado | recibido
  source    String   @default("manual") // manual | calculadora | comparador
  createdAt DateTime @default(now())

  @@index([obraId])
}

// Gasto / pago registrado en la obra.
model ObraExpense {
  id          String     @id @default(cuid())
  obraId      String
  obra        Obra       @relation(fields: [obraId], references: [id], onDelete: Cascade)
  rubroId     String?
  rubro       ObraRubro? @relation(fields: [rubroId], references: [id], onDelete: SetNull)
  description String
  amount      Float
  date        DateTime   @default(now())
  createdAt   DateTime   @default(now())

  @@index([obraId])
}

// Libro/diario de obra: qué se hizo cada día, con foto.
model ObraLog {
  id        String   @id @default(cuid())
  obraId    String
  obra      Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  title     String
  note      String?
  photo     String?
  createdAt DateTime @default(now())

  @@index([obraId, date])
}

// Cálculos de materiales guardados (presupuestos estimados).
model SavedCalculation {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name      String // "Casa de 100m²", "Amurado del patio", etc.
  calcType  String // "h17" | "h21" | "h30" | "ladrillo" | "bloque" | etc.
  quantity  Float // cantidad base (m² o kg o m³)
  result    String // JSON: { cemento: 10, arena: 20, ... } (Cantidad total de material)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
}

// Bolsa de trabajo — profesionales asociados.
model Professional {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  profession  String // "Arquitecto/a", "Ingeniero/a Civil", "Maestro Mayor de Obra", etc.
  bio         String
  photo       String?
  location    String   @default("Córdoba")
  phone       String?
  whatsapp    String?
  email       String?
  specialties String   @default("") // pipe separated
  featured    Boolean  @default(false)
  active      Boolean  @default(true) // controlado por suscripción a futuro
  demo        Boolean  @default(false) // perfil de ejemplo: se muestra etiquetado
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, featured])
}

// Servicio inmobiliario — inmuebles publicados por constructoras/inmobiliarias.
model Property {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  operation   String   @default("venta") // "venta" | "alquiler"
  type        String   @default("casa") // casa | departamento | lote | local | oficina
  price       Float?
  currency    String   @default("USD") // USD | ARS
  location    String
  bedrooms    Int?
  bathrooms   Int?
  area        Float? // m2 cubiertos
  coverImage  String?
  images      String   @default("") // pipe separated URLs
  description String
  agency      String // constructora / inmobiliaria
  phone       String?
  whatsapp    String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  demo        Boolean  @default(false) // aviso de ejemplo: se muestra etiquetado
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, operation, type])
}

// Snapshot de precios: el cron guarda el precio más barato en vivo por material
// cada X horas. Alimenta el presupuesto (lectura rápida) y el histórico/tendencia.
model PriceSnapshot {
  id           String   @id @default(cuid())
  material     String // clave canónica: "cemento", "hierro", etc.
  providerId   String
  providerName String
  title        String
  price        Float
  unit         String
  url          String
  capturedAt   DateTime @default(now())

  @@index([material, capturedAt])
  @@index([capturedAt])
}

// Noticias de la construcción curadas por el admin (links a medios externos).
model News {
  id        String   @id @default(cuid())
  title     String
  summary   String?
  source    String // medio (ej "La Voz del Interior")
  url       String
  image     String?
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}
