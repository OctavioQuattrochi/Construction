// Construction — data model
// Dev uses SQLite. For production switch provider to "postgresql" and update DATABASE_URL.

generator client {
  provider      = "prisma-client-js"
  // "native" para tu máquina; "rhel-openssl-3.0.x" para las funciones de Netlify (AWS Lambda).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  color       String    @default("#f0a500")
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String    // Markdown
  coverImage  String?
  readMinutes Int       @default(5)
  featured    Boolean   @default(false)
  published   Boolean   @default(true)
  author      String    @default("Juan Carlos Quattrochi")
  tags        String    @default("") // comma separated
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, featured])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String
  description String
  icon        String   @default("HardHat") // lucide icon name
  features    String   @default("")         // pipe separated
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Flexible key/value store for editable homepage / site content blocks.
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  service   String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled])
}
