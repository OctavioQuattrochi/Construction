# === Base de datos (PostgreSQL) ===
# Usá una Postgres en la nube (Neon, Netlify DB, Supabase…).
# Neon: copiá el "Connection string" con sslmode=require.
DATABASE_URL="postgresql://usuario:password@host.neon.tech/dbname?sslmode=require"

# === Auth ===
# Secreto de sesión. Generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="cambiame-por-un-string-aleatorio-largo-de-al-menos-32-chars"

# === Admin inicial (lo usa el seed) ===
ADMIN_EMAIL="admin@construccion.com.ar"
ADMIN_PASSWORD="CambiaEstaClave123!"

# === Sitio ===
NEXT_PUBLIC_SITE_URL="https://tu-sitio.netlify.app"
NEXT_PUBLIC_WHATSAPP="5493511234567"
NEXT_PUBLIC_CONTACT_EMAIL="hola@bildap.com.ar"

# === Google OAuth (opcional — registro de usuarios con Google) ===
# Creá credenciales en https://console.cloud.google.com (OAuth 2.0 Client, tipo Web).
# Authorized redirect URI: https://TU-SITIO/api/auth/google/callback
# Si quedan vacías, el botón "Ingresar con Google" muestra "próximamente".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
