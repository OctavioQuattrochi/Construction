# === Base de datos (PostgreSQL) ===
# Usá una Postgres en la nube (Neon, Netlify DB, Supabase…).
# Neon: copiá el "Connection string" con sslmode=require.
DATABASE_URL="postgresql://usuario:password@host.neon.tech/dbname?sslmode=require"

# === Auth ===
# Secreto de sesión. Generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="cambiame-por-un-string-aleatorio-largo-de-al-menos-32-chars"

# === Admin inicial (lo usa el seed) ===
ADMIN_EMAIL="admin@construccion.com.ar"
ADMIN_PASSWORD="CambiaEstaClave123!"

# === Sitio ===
NEXT_PUBLIC_SITE_URL="https://tu-sitio.netlify.app"
NEXT_PUBLIC_WHATSAPP="5493511234567"
NEXT_PUBLIC_CONTACT_EMAIL="hola@bildap.com.ar"

# === Google OAuth (opcional — registro de usuarios con Google) ===
# Creá credenciales en https://console.cloud.google.com (OAuth 2.0 Client, tipo Web).
# Authorized redirect URI: https://TU-SITIO/api/auth/google/callback
# Si quedan vacías, el botón "Ingresar con Google" muestra "próximamente".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# === Email / notificación de leads (Resend — https://resend.com) ===
# API key de Resend. Si queda vacía, los emails se omiten (no rompe nada).
RESEND_API_KEY=""
# Remitente. Sin dominio verificado usá el de prueba de Resend:
RESEND_FROM="BildAp <onboarding@resend.dev>"
# A dónde llegan las notificaciones de consultas y suscriptores.
LEAD_NOTIFY_EMAIL="octavioq21@gmail.com"

# === Analytics (opcional — configurá UNO) ===
# Google Analytics 4:
NEXT_PUBLIC_GA_ID=""
# o Plausible (alternativa liviana y sin cookies):
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# === Cron de precios (refresco del snapshot de materiales) ===
# Secret para autorizar el endpoint /api/cron/refresh-prices. Poné algo largo.
CRON_SECRET=""

# === Monitoreo de errores (opcional — Sentry https://sentry.io) ===
# DSN del proyecto de Sentry. Si queda vacío, el SDK no hace nada (no-op).
# El DSN no es secreto (sólo permite enviar eventos). Se usa en cliente y servidor.
NEXT_PUBLIC_SENTRY_DSN=""
# Opcional: para subir source maps en el build (mejores stack traces).
# Creá el token en Sentry → Settings → Auth Tokens.
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
